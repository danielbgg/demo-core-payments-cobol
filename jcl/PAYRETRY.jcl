//PAYRETRY JOB (DEMO),'PAYMENT RETRY',CLASS=A,MSGCLASS=X
//* Synthetic retry flow: rejected payments are reprocessed by PAYPROC.
//STEP010  EXEC PGM=PAYPROC
//PAYIN    DD DSN=DEMO.PAYMENTS.REJECTED,DISP=SHR
//PAYOUT   DD DSN=DEMO.PAYMENTS.RETRY.APPROVED,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1)),UNIT=SYSDA
//PAYERR   DD DSN=DEMO.PAYMENTS.RETRY.REJECTED,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSOUT   DD SYSOUT=*
