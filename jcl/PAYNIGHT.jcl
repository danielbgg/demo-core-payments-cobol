//PAYNIGHT JOB (DEMO),'NIGHTLY PAYMENTS',CLASS=A,MSGCLASS=X
//* Synthetic nightly corporate-payment processing job.
//STEP010  EXEC PGM=PAYPROC
//PAYIN    DD DSN=DEMO.PAYMENTS.INPUT,DISP=SHR
//PAYOUT   DD DSN=DEMO.PAYMENTS.APPROVED,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1)),UNIT=SYSDA
//PAYERR   DD DSN=DEMO.PAYMENTS.REJECTED,DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(1,1)),UNIT=SYSDA
//SYSOUT   DD SYSOUT=*
